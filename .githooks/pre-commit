#!/bin/sh
# Refreshes the README provider catalog from the production registry before each commit.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip for one commit:    git commit --no-verify
# Never blocks a commit: any failure is reported and the commit proceeds without the refresh.

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found; README.md provider catalog not refreshed" >&2
  exit 0
fi

if ! git diff --quiet -- README.md; then
  echo "pre-commit: README.md has unstaged changes; provider catalog not refreshed" >&2
  exit 0
fi

if node scripts/docs/update_provider_listings.js --fetch; then
  git add -- README.md
else
  echo "pre-commit: provider catalog refresh failed; committing without it" >&2
fi
exit 0
